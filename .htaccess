# === Лимиты для больших запросов ===
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 256M

# === Безопасность: Заголовки HTTP ===
<IfModule mod_headers.c>
    # Принудительный HTTPS (включить после настройки SSL)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    
    # Защита от clickjacking
    Header always set X-Frame-Options "DENY"
    
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Запрет определения MIME типа
    Header always set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (базовая защита)
    Header always set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' https: data:;"
</IfModule>

# === Редирект на HTTPS (раскомментировать после настройки SSL) ===
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteCond %{HTTP_HOST} !^localhost [NC]
#     RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# === Защита конфиденциальных файлов ===
# Блокировка доступа к файлам конфигурации и логам
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "^\.optimization_applied">
    Require all denied
</FilesMatch>
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(log|bak|backup|tmp)$">
    Require all denied
</FilesMatch>

# Внутренняя документация (CLAUDE.md, PROJECT_AUDIT.md, README и т.п.) и
# Markdown-файлы — не должны быть доступны на публичном домене.
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# SQL-дампы и миграции — раскрывают схему БД, в вебе им делать нечего.
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# Блокировка доступа к папкам
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Запрет доступа к скрытым файлам/папкам (начинаются с точки)
    RewriteRule ^\.(?!well-known/) - [F]
    # Каталоги с тестами и внутренней документацией — не для веба
    RewriteRule ^(tests|docs|openspec)/ - [F,L]
    # Серверные каталоги: подключаются из кода через require, по HTTP не нужны.
    # Что проверено на проде 2026-08-08 до этого правила:
    #   includes/*.php  → HTTP 200 (пустое тело: файл выполнялся, объявлял класс);
    #   sql/*.sql       → HTTP 200 и полный текст схемы БД;
    #   tools/migrations/apply_indexes_safe.php → HTTP 200 с Parse error, в котором
    #     светился абсолютный путь /home/if592995/panel.account-factory.site/www/...
    # Ни один фронтовый запрос сюда не ходит (проверено грепом по assets/js и templates).
    RewriteRule ^(includes|tools|sql)/ - [F,L]
</IfModule>

# === Кэширование статических ресурсов ===
<IfModule mod_expires.c>
    ExpiresActive On
    
    # CSS и JavaScript - минифицированные версии кэшируем дольше
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Собранные файлы (build) кэшируем еще дольше
    <FilesMatch "\.(min\.css|min\.js)$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>
    
    # Изображения
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    
    # Шрифты
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    
    # HTML и JSON не кэшируем
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# === Сжатие для ускорения загрузки ===
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/x-font-ttf application/x-font-opentype
    AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# === ETag для условных запросов ===
<IfModule mod_headers.c>
    # Включаем ETag для статических файлов
    FileETag MTime Size
    
    # Кэширование для собранных файлов
    <FilesMatch "\.(min\.css|min\.js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Кэширование для обычных CSS/JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# === Отключение вывода версии PHP и текстов ошибок ===
# display_errors: config.php выставляет его в 0, но Parse error случается ДО
# выполнения кода — и тогда текст ошибки уходит в браузер вместе с абсолютным
# путём на сервере (наблюдалось на проде 2026-08-08). Гасим на уровне сервера.
# Логирование при этом не трогаем: ошибки по-прежнему пишутся в лог.
<IfModule mod_php.c>
    php_flag expose_php Off
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php7.c>
    php_flag expose_php Off
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# === Защита от директорного листинга ===
Options -Indexes

# === Файл индекса по умолчанию ===
DirectoryIndex login.php index.php
